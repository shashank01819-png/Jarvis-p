    w = get_weather("Bengaluru")
    gui.set_weather(w)
    gui.root.after(600000, refresh_weather_tile)

# ---------------- Command handler ----------------
def handle_command(command):
    global SPEECH_RATE, SPEECH_VOLUME

    if "exit" in command or "stop" in command:
        speak("Goodbye!")
        return

    elif "remind me" in command:
        task = command.replace("remind me to", "").replace("remind me", "").strip()
        save_reminder(task)
        speak(f"Yep, I'll remind you: {task}")

    elif "what are my reminders" in command or "list reminders" in command:
        list_reminders()

    elif "i am working on" in command or "i'm working on" in command:
        task = command.replace("i am working on", "").replace("i'm working on", "").strip()
        save_current_task(task)
        speak(f"Got it, I'll remember you're working on {task}.")

    elif "open browser" in command or "open chrome" in command:
        webbrowser.open("https://www.google.com")
        speak("Opening browser.")

    elif "open youtube" in command or "youtube" in command:
        webbrowser.open("https://www.youtube.com")
        speak("It's opened.")

    elif "open notepad" in command:
        subprocess.Popen("notepad.exe")
        speak("Opening Notepad.")

    elif "play music" in command:
        music_folder = "C:\\Users\\shash\\Music"
        audio_extensions = (".mp4", ".wav", ".m4a", ".flac","mp3")
        songs = [f for f in os.listdir(music_folder) if f.lower().endswith(audio_extensions)]
        if songs:
            chosen = random.choice(songs)
            os.startfile(os.path.join(music_folder, chosen))
            speak(f"Playing {chosen}.")
        else:
            speak("I couldn't find any music files in your Music folder.")

    elif "what is time" in command or "what time" in command:
        speak(datetime.now().strftime("It's %I:%M %p"))

    elif "open file explorer" in command:
        os.startfile("C:\\Users\\shash")
        speak("Opening file explorer.")

    elif "search for" in command or "google" in command:
        query = command.replace("search for", "").replace("google", "").strip()
        speak("Let me check.")
        result = search_google(query)
        speak(result)

    elif "weather" in command:
        speak("Checking the weather.")
        result = get_weather("Bengaluru")
        speak(f"It's currently {result} in Bengaluru.")

    elif "close" in command:
        app_name = command.replace("close", "").strip()
        result = close_app(app_name)
        speak(result)

    elif "talk slower" in command or "speak slower" in command:
        SPEECH_RATE = "-20%"
        speak("Okay, slowing down a bit.")

    elif "talk faster" in command or "speak faster" in command:
        SPEECH_RATE = "+20%"
        speak("Sure, speeding up.")

    elif "speak up" in command or "louder" in command:
        SPEECH_VOLUME = "+50%"
        speak("Got it, talking louder now.")

    elif "speak quieter" in command or "lower your voice" in command:
        SPEECH_VOLUME = "-50%"
        speak("Okay, quieter now.")

    elif any(place in command for place in KNOWN_PLACES) and "open" in command:
        for place, path in KNOWN_PLACES.items():
            if place in command:
                os.startfile(path)
                speak(f"Opening {place}.")
                break

    else:
        reply = ask_ai(command)
        speak(reply)

# ---------------- Main assistant loop ----------------
def run_assistant():
    try:
        with sr.Microphone() as source:
            recognizer.adjust_for_ambient_noise(source)
    except Exception:
        print("Warning: microphone calibration failed.")

    greetings = ["Hey buddy!", "Yo, what's up?", "Hi there!", "Hello friend!"]
    speak(random.choice(greetings))

    last_task = load_current_task()
    if last_task:
        speak(f"Last time you were working on something {last_task['task']}. Do you want me to continue that?")
        answer = listen()
        if "yes" in answer:
            speak("Great, come on then lets finish it.")
        elif "no" in answer:
            speak("No worries, then whats new today buddy.")

    while True:
        try:
            typed = text_command_queue.get_nowait()
            handle_command(typed)
            continue
        except queue.Empty:
            pass

        command = listen()
        if command == "":
            continue
        if "exit" in command or "stop" in command:
            speak("Goodbye!")
            break
        handle_command(command)

# ---------------- Start everything ----------------
assistant_thread = threading.Thread(target=run_assistant, daemon=True)
assistant_thread.start()

