# ---------------- GUI ----------------
class AssistantGUI:
    BG = "#060a14"
    PANEL = "#0c1526"

    def __init__(self):
        self.theme_name = "cyan"
        self.accent = THEMES[self.theme_name]["accent"]
        self.dim = THEMES[self.theme_name]["dim"]

        self.root = tk.Tk()
        self.root.title("Buddy")
        self.root.geometry("340x660")
        self.root.configure(bg=self.BG)
        self.root.attributes("-topmost", True)

        self.state = "idle"
        self.angle = 0
        self.pulse = 40
        self.pulse_dir = 1
        self.wave_bars = [4] * 24

        theme_frame = tk.Frame(self.root, bg=self.BG)
        theme_frame.pack(pady=(8, 0))
        self.theme_canvas = tk.Canvas(theme_frame, width=140, height=22, bg=self.BG, highlightthickness=0)
        self.theme_canvas.pack()
        self._draw_theme_dots()
        self.theme_canvas.bind("<Button-1>", self._on_theme_click)

        self.clock_label = tk.Label(self.root, text="", fg=self.accent, bg=self.BG, font=("Consolas", 12))
        self.clock_label.pack(pady=(6, 0))

        self.canvas = tk.Canvas(self.root, width=260, height=260, bg=self.BG, highlightthickness=0)
        self.canvas.pack(pady=5)

        status_frame = tk.Frame(self.root, bg=self.BG)
        status_frame.pack()
        self.icon_label = tk.Label(status_frame, text="◎", fg=self.accent, bg=self.BG, font=("Consolas", 12))
        self.icon_label.pack(side="left", padx=(0, 5))
        self.status_label = tk.Label(status_frame, text="STANDING BY", fg=self.accent, bg=self.BG, font=("Consolas", 10, "bold"))
        self.status_label.pack(side="left")

        self.wave_canvas = tk.Canvas(self.root, width=280, height=40, bg=self.BG, highlightthickness=0)
        self.wave_canvas.pack(pady=(4, 0))

        self.log = scrolledtext.ScrolledText(self.root, height=7, width=38, bg=self.PANEL, fg=self.accent,
                                              insertbackground=self.accent, font=("Consolas", 9), bd=0, wrap="word")
        self.log.pack(pady=10, padx=10)
        self.log.insert(tk.END, "[ BUDDY ONLINE ]\n[ SAY 'HEY BUDDY' OR TYPE BELOW ]\n\n")
        self.log.configure(state="disabled")

        input_frame = tk.Frame(self.root, bg=self.BG)
        input_frame.pack(pady=5, padx=10, fill="x")

        self.entry = tk.Entry(input_frame, bg=self.PANEL, fg=self.accent, insertbackground=self.accent,
                               font=("Consolas", 10), bd=0)
        self.entry.pack(side="left", fill="x", expand=True, ipady=6, padx=(0, 5))
        self.entry.bind("<Return>", self._on_send)

        send_btn = tk.Button(input_frame, text="➤", bg=self.PANEL, fg=self.accent, bd=0,
                              activebackground=self.dim, command=self._on_send)
        send_btn.pack(side="left")

        self.mic_btn = tk.Button(input_frame, text="🎤", bg=self.PANEL, fg="#ff4444", bd=1,
                                  highlightbackground="#ff4444", command=self._toggle_mic)
        self.mic_btn.pack(side="left", padx=(5, 0))

        tiles = tk.Frame(self.root, bg=self.BG)
        tiles.pack(pady=10, padx=10, fill="x")

        self.weather_label = tk.Label(tiles, text="☁ WEATHER\n--", fg=self.accent, bg=self.PANEL,
                                       font=("Consolas", 9), justify="left", anchor="w", padx=8, pady=6)
        self.weather_label.grid(row=0, column=0, sticky="ew", padx=(0, 5))

        self.local_time_label = tk.Label(tiles, text="🕐 LOCAL TIME\n--", fg=self.accent, bg=self.PANEL,
                                          font=("Consolas", 9), justify="left", anchor="w", padx=8, pady=6)
        self.local_time_label.grid(row=0, column=1, sticky="ew")

        tiles.columnconfigure(0, weight=1)
        tiles.columnconfigure(1, weight=1)

        self._update_clock()
        self._animate()

    def _draw_theme_dots(self):
        self.theme_canvas.delete("all")
        x = 10
        self.theme_dot_positions = {}
        for name, colors in THEMES.items():
            self.theme_canvas.create_oval(x, 4, x + 16, 20, fill=colors["accent"], outline="")
            self.theme_dot_positions[(x, x + 16)] = name
            x += 30

    def _on_theme_click(self, event):
        for (x1, x2), name in self.theme_dot_positions.items():
            if x1 <= event.x <= x2:
                self._apply_theme(name)
                break

    def _apply_theme(self, name):
        self.theme_name = name
        self.accent = THEMES[name]["accent"]
        self.dim = THEMES[name]["dim"]
        self.clock_label.configure(fg=self.accent)
        self.icon_label.configure(fg=self.accent)
        self.status_label.configure(fg=self.accent)
        self.log.configure(fg=self.accent, insertbackground=self.accent)
        self.entry.configure(fg=self.accent, insertbackground=self.accent)
        self.weather_label.configure(fg=self.accent)
        self.local_time_label.configure(fg=self.accent)

    def _on_send(self, event=None):
        text = self.entry.get().strip()
        if text:
            self.entry.delete(0, tk.END)
            self.add_log(f"You (typed): {text}")
            text_command_queue.put(text.lower())

    def _toggle_mic(self):
        if mic_muted.is_set():
            mic_muted.clear()
            self.mic_btn.configure(fg="#ff4444", highlightbackground="#ff4444")
        else:
            mic_muted.set()
            self.mic_btn.configure(fg="#555555", highlightbackground="#555555")

    def add_log(self, text):
        self.log.configure(state="normal")
        self.log.insert(tk.END, text + "\n")
        self.log.see(tk.END)
        self.log.configure(state="disabled")

    def set_state(self, state):
        self.state = state
        labels = {
            "idle": "STANDING BY",
            "listening": "LISTENING...",
            "thinking": "PROCESSING...",
            "speaking": "SPEAKING...",
        }
        icons = {"idle": "◎", "listening": "🎤", "thinking": "⚙", "speaking": "🔊"}
        self.status_label.configure(text=labels.get(state, "STANDING BY"))
        self.icon_label.configure(text=icons.get(state, "◎"))

    def set_weather(self, text):
        self.weather_label.configure(text=f"☁ WEATHER\n{text}")

    def _update_clock(self):
        now = datetime.now().strftime("%H:%M:%S")
        self.clock_label.configure(text=now)
        self.local_time_label.configure(text=f"🕐 LOCAL TIME\n{datetime.now().strftime('%H:%M')}")
        self.root.after(1000, self._update_clock)

    def _animate(self):
        self.canvas.delete("all")
        cx, cy = 130, 130

        color = {"idle": self.dim, "listening": self.accent, "thinking": "#e0a020", "speaking": "#2ecc71"}.get(self.state, self.dim)

        self.canvas.create_oval(cx - 100, cy - 100, cx + 100, cy + 100, outline=self.dim, width=1)

        self.angle = (self.angle + 3) % 360
        self.canvas.create_arc(cx - 90, cy - 90, cx + 90, cy + 90, start=self.angle, extent=80,
                                outline=self.accent, width=2, style="arc")
        self.canvas.create_arc(cx - 90, cy - 90, cx + 90, cy + 90, start=self.angle + 180, extent=80,
                                outline=self.accent, width=2, style="arc")

        if self.state in ("listening", "speaking", "thinking"):
            self.pulse += 1.5 * self.pulse_dir
            if self.pulse >= 55:
                self.pulse_dir = -1
            elif self.pulse <= 40:
                self.pulse_dir = 1
        else:
            self.pulse = 40

        self.canvas.create_oval(cx - self.pulse, cy - self.pulse, cx + self.pulse, cy + self.pulse,
                                 fill=color, outline="")
        self.canvas.create_oval(cx - 15, cy - 15, cx + 15, cy + 15, fill="#ffffff", outline="")

        self._draw_waveform()

        self.root.after(30, self._animate)

    def _draw_waveform(self):
        self.wave_canvas.delete("all")
        active = self.state in ("listening", "speaking")
        bar_width = 8
        gap = 4
        x = 5
        for i in range(len(self.wave_bars)):
            if active:
                target = random.randint(4, 36)
                self.wave_bars[i] += (target - self.wave_bars[i]) * 0.4
            else:
                self.wave_bars[i] += (3 - self.wave_bars[i]) * 0.2
            h = max(2, self.wave_bars[i])
            color = self.accent if active else self.dim
            self.wave_canvas.create_rectangle(x, 20 - h / 2, x + bar_width, 20 + h / 2, fill=color, outline="")
            x += bar_width + gap

    def run(self):
        self.root.mainloop()

gui = AssistantGUI()

# ---------------- Voice / AI functions ----------------

def _voice_interrupt_listener():
    interrupt_flag.clear()
    print(f"(Interrupt listener started, threshold={recognizer.energy_threshold})")
    try:
        with sr.Microphone() as source:
            while pygame.mixer.music.get_busy() and not interrupt_flag.is_set():
                try:
                    audio = recognizer.listen(source, timeout=0.5, phrase_time_limit=2)
                    text = recognizer.recognize_google(audio)
                    if WAKE_WORD in text.lower():
                        interrupt_flag.set()
                        wake_interrupt_triggered.set()
                        pygame.mixer.music.stop()
                except sr.WaitTimeoutError:
                    continue
                except sr.UnknownValueError:
                    continue
                except sr.RequestError:
                    continue
    except Exception as e:
        print(f"(Interrupt listener crashed: {e})")

async def _speak_async(text):
    filename = f"temp_voice_{uuid.uuid4().hex}.mp3"
    try:
        communicate = edge_tts.Communicate(text, "en-US-JennyNeural", rate=SPEECH_RATE, volume=SPEECH_VOLUME)
        await communicate.save(filename)

        pygame.mixer.music.load(filename)
        pygame.mixer.music.play()

        listener_thread = threading.Thread(target=_voice_interrupt_listener, daemon=True)
        listener_thread.start()

        while pygame.mixer.music.get_busy():
            await asyncio.sleep(0.1)

        interrupt_flag.set()
        pygame.mixer.music.unload()
    except Exception as e:
        print(f"Voice error: {e}")
    finally:
        if os.path.exists(filename):
            os.remove(filename)

def speak(text):
    print(f"Assistant: {text}")
    gui.add_log(f"Buddy: {text}")
    gui.set_state("speaking")
    asyncio.run(_speak_async(text))
    gui.set_state("idle")

    if wake_interrupt_triggered.is_set():
        wake_interrupt_triggered.clear()
        speak("Yes? What do you need?")

def listen():
    if mic_muted.is_set():
        return ""
    gui.set_state("listening")
    with sr.Microphone() as source:
        print("Listening...")
        try:
            audio = recognizer.listen(source, timeout=5, phrase_time_limit=8)
        except sr.WaitTimeoutError:
            gui.set_state("idle")
            return ""
    gui.set_state("idle")
    try:
        text = recognizer.recognize_google(audio)
        print(f"You said: {text}")
        gui.add_log(f"You: {text}")
        return text.lower()
    except sr.UnknownValueError:
        return ""
    except sr.RequestError:
        speak("I'm having trouble connecting to the internet right now.")
        return ""
    except Exception:
        return ""

def ask_ai(prompt):
    global conversation_history
    gui.set_state("thinking")
    system_prompt = (
        "You are a warm, friendly assistant who talks like a close friend. "
        "Keep replies short, casual, and conversational — no long explanations "
        "or numbered steps unless specifically asked. Use natural, relaxed language. "
        "Use the conversation history to stay consistent with what was said earlier."
    )
    history_text = ""
    for turn in conversation_history[-MAX_HISTORY:]:
        history_text += f"User: {turn['user']}\nFriend: {turn['assistant']}\n"

    full_prompt = f"{system_prompt}\n\n{history_text}User: {prompt}\nFriend:"

    try:
        response = requests.post('http://localhost:11434/api/generate', json={
            "model": "phi3",
            "prompt": full_prompt,
            "stream": False,
            "keep_alive": -1
        }, timeout=30)
        response.raise_for_status()
        reply = response.json()['response']
    except requests.exceptions.ConnectionError:
        gui.set_state("idle")
        return "I can't reach my thinking engine right now — is Ollama running?"
    except requests.exceptions.Timeout:
        gui.set_state("idle")
        return "That took too long to think about — can you try again?"
    except Exception:
        gui.set_state("idle")
        return "Something went wrong on my end, sorry about that."

    conversation_history.append({"user": prompt, "assistant": reply})
    if len(conversation_history) > MAX_HISTORY:
        conversation_history = conversation_history[-MAX_HISTORY:]

    gui.set_state("idle")
    return reply

def load_reminders():
    if os.path.exists(REMINDER_FILE):
        with open(REMINDER_FILE, 'r') as f:
            return json.load(f)
    return []

def save_reminder(task):
    reminders = load_reminders()
    reminders.append({"task": task, "created": str(datetime.now())})
    with open(REMINDER_FILE, 'w') as f:
        json.dump(reminders, f)

def list_reminders():
    reminders = load_reminders()
    if not reminders:
        speak("You have no reminders.")
        return
    speak(f"You have {len(reminders)} reminders.")
    for r in reminders:
        speak(r['task'])

def save_current_task(task):
    with open(CURRENT_TASK_FILE, 'w') as f:
        json.dump({"task": task, "saved_at": str(datetime.now())}, f)

def load_current_task():
    if os.path.exists(CURRENT_TASK_FILE):
        with open(CURRENT_TASK_FILE, 'r') as f:
            return json.load(f)
    return None

def search_google(query):
    try:
        url = f"https://api.duckduckgo.com/?q={query}&format=json&no_html=1"
        r = requests.get(url, timeout=5)
        data = r.json()
        if data.get("AbstractText"):
            return data["AbstractText"]
        elif data.get("RelatedTopics") and len(data["RelatedTopics"]) > 0:
            first = data["RelatedTopics"][0]
            return first.get("Text", "I couldn't find a clear answer.")
        else:
            return "I couldn't find a quick answer, want me to open a browser search instead?"
    except requests.exceptions.ConnectionError:
        return "I can't search right now, looks like the internet's down."
    except Exception:
        return "Something went wrong with the search."

def get_weather(city="Bengaluru"):
    try:
        url = f"https://wttr.in/{city}?format=%C+%t"
        r = requests.get(url, timeout=5)
        return r.text.strip()
    except Exception:
        return "unavailable"

def close_app(app_name):
    app_map = {
        "chrome": "chrome.exe",
        "notepad": "notepad.exe",
        "word": "WINWORD.EXE",
        "excel": "EXCEL.EXE",
        "spotify": "Spotify.exe",
        "file explorer": "explorer.exe",
        "explorer": "explorer.exe",
    }
    exe = app_map.get(app_name)
    if exe:
        os.system(f"taskkill /f /im {exe}")
        return f"Closed {app_name}."

    running = set()
    for proc in psutil.process_iter(['name']):
        try:
            running.add(proc.info['name'])
        except Exception:
            continue

    running_list = list(running)
    lower_names = [r.lower() for r in running_list]
    matches = difflib.get_close_matches(app_name.lower(), lower_names, n=1, cutoff=0.4)

    if matches:
        idx = lower_names.index(matches[0])
        real_name = running_list[idx]
        os.system(f"taskkill /f /im \"{real_name}\"")
        return f"Closed {real_name}."

    return f"I couldn't find anything running called {app_name}."

